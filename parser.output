Grammar

    0 $accept: program $end

    1 program: external_declaration
    2        | program external_declaration

    3 external_declaration: function_definition
    4                     | declaration

    5 function_definition: type_specifier IDENTIFIER LPAREN parameter_list RPAREN LBRACE statement_list RBRACE
    6                    | type_specifier IDENTIFIER LPAREN RPAREN LBRACE statement_list RBRACE

    7 declaration: type_specifier IDENTIFIER SEMICOLON
    8            | type_specifier IDENTIFIER ASSIGN expression SEMICOLON

    9 type_specifier: INT
   10               | FLOAT
   11               | DOUBLE
   12               | CHAR
   13               | VOID

   14 parameter_list: parameter
   15               | parameter_list COMMA parameter

   16 parameter: type_specifier IDENTIFIER

   17 statement: expression SEMICOLON
   18          | declaration
   19          | LBRACE statement_list RBRACE
   20          | LBRACE RBRACE
   21          | IF LPAREN expression RPAREN statement
   22          | IF LPAREN expression RPAREN statement ELSE statement
   23          | WHILE LPAREN expression RPAREN statement
   24          | FOR LPAREN expression SEMICOLON expression SEMICOLON expression RPAREN statement
   25          | RETURN expression SEMICOLON
   26          | RETURN SEMICOLON
   27          | BREAK SEMICOLON
   28          | CONTINUE SEMICOLON

   29 statement_list: statement
   30               | statement_list statement
   31               | ε

   32 expression: assignment_expression

   33 assignment_expression: logical_or_expression
   34                      | IDENTIFIER ASSIGN assignment_expression

   35 logical_or_expression: logical_and_expression
   36                      | logical_or_expression OR logical_and_expression

   37 logical_and_expression: equality_expression
   38                       | logical_and_expression AND equality_expression

   39 equality_expression: relational_expression
   40                    | equality_expression EQUAL relational_expression
   41                    | equality_expression NOT_EQUAL relational_expression

   42 relational_expression: additive_expression
   43                      | relational_expression LESS additive_expression
   44                      | relational_expression GREATER additive_expression
   45                      | relational_expression LESS_EQUAL additive_expression
   46                      | relational_expression GREATER_EQUAL additive_expression

   47 additive_expression: multiplicative_expression
   48                    | additive_expression PLUS multiplicative_expression
   49                    | additive_expression MINUS multiplicative_expression

   50 multiplicative_expression: unary_expression
   51                          | multiplicative_expression MULTIPLY unary_expression
   52                          | multiplicative_expression DIVIDE unary_expression
   53                          | multiplicative_expression MODULO unary_expression

   54 unary_expression: postfix_expression
   55                 | PLUS unary_expression
   56                 | MINUS unary_expression
   57                 | NOT unary_expression
   58                 | INCREMENT unary_expression
   59                 | DECREMENT unary_expression

   60 postfix_expression: primary_expression
   61                   | postfix_expression LPAREN RPAREN
   62                   | postfix_expression LPAREN assignment_expression RPAREN
   63                   | IDENTIFIER LPAREN RPAREN
   64                   | IDENTIFIER LPAREN assignment_expression RPAREN
   65                   | postfix_expression LBRACKET expression RBRACKET
   66                   | postfix_expression INCREMENT
   67                   | postfix_expression DECREMENT

   68 primary_expression: IDENTIFIER
   69                   | IDENTIFIER LPAREN RPAREN
   70                   | IDENTIFIER LPAREN assignment_expression RPAREN
   71                   | INTEGER_LITERAL
   72                   | FLOAT_LITERAL
   73                   | STRING_LITERAL
   74                   | CHAR_LITERAL
   75                   | LPAREN expression RPAREN


